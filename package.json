{
  "name": "magpie-agent-trae-bridge",
  "version": "0.7.1",
  "type": "module",
  "description": "Make Trae (CN / global) use every model and routing group configured in Magpie. The model picker returns the Magpie catalog; Trae's own login is untouched.",
  "license": "MIT",
  "magpie": {
    "agent": "./agent.js",
    "hooks": "./checkin.hooks.mjs",
    "icon": "data:image/png;base64,",
    "name": "Trae · Magpie Bridge",
    "page": {
      "title": "Trae check-in",
      "titles": {
        "zh": "Trae 签到",
        "zh-TW": "Trae 簽到",
        "ja": "Trae チェックイン",
        "de": "Trae-Check-in"
      },
      "file": "page/index.html",
      "icon": "page/icon.svg"
    }
  },
  "main": "./plugin.js",
  "engines": {
    "node": ">=20",
    "magpie": ">=0.1.1318"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "scripts": {
    "test": "node test/run.mjs",
    "icon": "node scripts/make-icon.mjs --write",
    "install-bridge": "node bin/trae-magpie.js install",
    "status": "node bin/trae-magpie.js status",
    "uninstall": "node bin/trae-magpie.js uninstall",
    "doctor": "node bin/trae-magpie.js doctor",
    "serve": "node bin/trae-magpie.js serve"
  },
  "files": [
    "agent.js",
    "plugin.js",
    "bin",
    "lib",
    "icon.png",
    "scripts",
    "setup.cmd",
    "setup.ps1",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "checkin.hooks.mjs",
    "page"
  ],
  "keywords": [
    "magpie",
    "magpie-agent",
    "trae",
    "byok",
    "routing-group",
    "magpie-page"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wovoemj/magpie-agent-trae-bridge.git"
  },
  "homepage": "https://github.com/Wovoemj/magpie-agent-trae-bridge#readme",
  "bugs": {
    "url": "https://github.com/Wovoemj/magpie-agent-trae-bridge/issues"
  },
  "author": "Wovoemj",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "trae-magpie": "./bin/trae-magpie.js"
  }
}
